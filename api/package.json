{
  "name": "@safari-trails/api",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Safari Trails REST API — Express + TypeScript + Drizzle ORM.",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "db:reset": "tsx src/db/reset.ts",
    "db:seed": "tsx src/seed/seed.ts"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.15",
    "@supabase/supabase-js": "^2.119.0",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^18.0.9",
    "drizzle-orm": "^0.45.4",
    "express": "^4.22.3",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "postgres": "^4.1.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.25",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.6.6",
    "@types/supertest": "^7.2.1",
    "drizzle-kit": "^0.31.11",
    "express-rate-limit": "^7.5.1",
    "supertest": "^7.3.2",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.1.0"
  }
}
