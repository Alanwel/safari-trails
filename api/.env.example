# ---------------------------------------------------------------------------
# Safari Trails API — environment
# Copy to `.env` and edit. `cp .env.example .env`
# ---------------------------------------------------------------------------

# Runtime
NODE_ENV=development
PORT=4000

# Comma-separated list of allowed browser origins. "*" = allow any (dev only).
CORS_ORIGIN=*

# ---------------------------------------------------------------------------
# DATABASE
# ---------------------------------------------------------------------------
# Leave DATABASE_URL EMPTY to run on the embedded PGlite database (local dev).
# PGlite is real Postgres compiled to WebAssembly, so the SQL is identical —
# you just get a local file instead of a hosted one.
DATABASE_URL=
PGLITE_PATH=./.data/pglite

# For Supabase (production), use the Supavisor *session* pooler so you can
# connect from an IPv4-only host, or the direct connection string:
#   postgresql://postgres.<project-ref>:<PASSWORD>@aws-0-<region>.pooler.supabase.com:6543/postgres
# DATABASE_URL=postgresql://postgres.abcdefghijkl:YOUR_PASSWORD@aws-0-eu-central-1.pooler.supabase.com:6543/postgres

# ---------------------------------------------------------------------------
# AUTH
# ---------------------------------------------------------------------------
# Secret used to sign admin JWTs. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=dev-only-secret-change-me-before-deploying-32chars

# Seeded admin account (created by `npm run db:seed`)
ADMIN_EMAIL=alanwel32@gmail.com
ADMIN_PASSWORD=SafariTrails2026!

# ---------------------------------------------------------------------------
# SUPABASE (optional — only needed for Storage image uploads)
# ---------------------------------------------------------------------------
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
