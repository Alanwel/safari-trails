# Web app environment.
# Copy to `web/.env` and edit. `cp .env.example .env`

# The API base URL.
# Leave EMPTY for local development — Vite proxies /api to http://localhost:4000
# (see vite.config.ts). In production set it to your deployed API:
#   VITE_API_URL=https://api.safaritrails.com
VITE_API_URL=

# The port the dev server listens on.
VITE_PORT=5173
